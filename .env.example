# Copy this to .env and fill in your values.
# .env is gitignored — never commit it.

# Neo4j password (must match neo4j.pass in config.yml)
NEO4J_PASSWORD=changeme

# Discord bridge authentication secret
# Must match adapters.discord.bridge_secret in config.yml
DISCORD_BRIDGE_SECRET=changeme_discord

# WhatsApp bridge authentication secret
# Must match adapters.whatsapp.bridge_secret in config.yml
WHATSAPP_BRIDGE_SECRET=changeme_whatsapp

# Gitea personal access token (used by the gitea-mcp-stdio server)
GITEA_TOKEN=changeme_gitea_token

# Host path for persistent NAS/external storage (bind-mounted into sandbox as /mnt/nas)
# Example: /mnt/nas/nami_ai  or  /media/user/mydrive/nami_ai
NAS_PATH=/mnt/nas/nami_ai

# Sandbox SSH password — leave empty to auto-generate on first start (recommended)
# Auto-generated password is stored in the sandbox_secrets Docker volume
SANDBOX_PASSWORD=

# Chromium binary path for the WhatsApp (Puppeteer) bridge.
# Default works on Debian/Ubuntu. Change if your distro installs it elsewhere.
# e.g. /usr/bin/google-chrome  or  /usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
