# API Server settings
api:
  host: "0.0.0.0"
  port: 11434  # Default Ollama port for compatibility

# AI Provider selection - choose which backend to use
ai_provider: ollama  # Options: ollama, openai, copilot, anthropic (when implemented)

# AI Provider configurations
providers:
  # Ollama provider configuration
  ollama:
    url: http://192.168.188.178:11434
    model: deepseek-r1:70b-llama-distill-q4_K_M-tools
    system_prompt: nami  # File in system_prompt/ directory
    max_tool_calls: 3

  # OpenAI provider configuration (requires: pip install openai)
  # Uncomment to use OpenAI instead of Ollama
  # openai:
  #   api_key: YOUR_OPENAI_API_KEY
  #   model: gpt-4
  #   system_prompt: nami
  #   organization: YOUR_ORG_ID  # optional

  # GitHub Copilot provider configuration (requires: pip install openai, and running copilot-api)
  # See external/copilot-api/README.md for setup instructions
  # Uncomment to use GitHub Copilot instead
  # copilot:
  #   url: http://localhost:4141  # copilot-api server URL
  #   model: gpt-4.1              # gpt-4.1, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
  #   api_key: dummy              # copilot-api uses dummy auth
  #   system_prompt: nami

  # Anthropic provider configuration (requires: pip install anthropic)
  # Uncomment to use Anthropic instead
  # anthropic:
  #   api_key: YOUR_ANTHROPIC_API_KEY
  #   model: claude-3-opus-20240229
  #   system_prompt: nami

# Bot settings
bot:
  brave_search_token: FOR_WEB_SEARCH
  log_level: INFO # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Legacy Discord bot settings (only needed if running main_discord_bot.py)
ai_channel:
- 1305130290384998441

# Settings to use ComfyUI for image generation.
comfyui: 
  negative_node: '7'
  output: image_output
  positive_node: '6'
  sampler_node: '3'
  server: 192.168.188.178:8188
  workflow: lunarcherry.json

dc:
  admin_role: 1165032494563864668
  permitted_users:
  - 210428907386699777
  sync_guild: -1
  token: DISCORD_TOKEN_HERE

# Used by the memory module to store data.
neo4j:
  pass: NEO4J_PASSWORD_HERE
  uri: bolt://192.168.188.178:7687
  user: neo4j

# Memory database embedding model
memory_db:
  model: all-MiniLM-L6-v2

# used to upload generated images to Nextcloud.
nextcloud:
  pass: NEXTCLOUD_PASSWORD_HERE
  url: http://nextcloud.example.com
  user: admin
